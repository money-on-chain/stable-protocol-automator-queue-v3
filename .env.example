# -----------------------------------------------------------------------
# Stable Protocol Automator Queue v3 — environment configuration
# Copy this file to .env and fill in your values.
# .env is never committed to version control.
# -----------------------------------------------------------------------

# ---------------- Account private keys (required) ----------------------
# Primary signing account.
ACCOUNT_PK_SECRET=your_private_key_here

# Optional: pass multiple keys in a single variable (comma-separated).
# ACCOUNT_PK_SECRET=pk1,pk2,pk3

# Optional: additional accounts via numbered variables.
# ACCOUNT_PK_SECRET_1=your_second_private_key
# ACCOUNT_PK_SECRET_2=your_third_private_key

# ---------------- Node connection (optional) ---------------------------
# Override the RPC endpoint set in config.json.
# APP_CONNECTION_URI=https://public-node.rsk.co

# ---------------- Full config override (optional) ----------------------
# Supply the entire config as a JSON string to skip config.json entirely.
# APP_CONFIG={"uri":"https://...","chain_id":30,...}
